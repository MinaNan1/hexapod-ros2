<?xml version="1.0"?>
<sdf version="1.6">
  <world name="destruction_site">

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Outer walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10 2</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10 2</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient></material></visual>
      </link>
    </model>

    <!-- Rubble obstacles -->
    <model name="rubble_1">
      <static>true</static>
      <pose>2 1.5 0.2 0.1 0.2 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.5 0.4</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient></material></visual>
      </link>
    </model>
    <model name="rubble_2">
      <static>true</static>
      <pose>-1.5 2 0.15 0.0 0.1 1.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.9 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.9 0.3</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient></material></visual>
      </link>
    </model>
    <model name="rubble_3">
      <static>true</static>
      <pose>-2 -2 0.25 0.2 0.0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.4 0.5</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient></material></visual>
      </link>
    </model>
    <model name="rubble_4">
      <static>true</static>
      <pose>3 -2 0.1 0.0 0.0 0.8</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.2</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient></material></visual>
      </link>
    </model>

    <!-- Red target object to find -->
    <model name="target_object">
      <static>true</static>
      <pose>-3 3 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>1.0 0.0 0.0 1</ambient></material></visual>
      </link>
    </model>

  </world>
</sdf>
