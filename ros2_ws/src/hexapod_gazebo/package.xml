<?xml version="1.0"?>
<package format="3">
  <name>hexapod_gazebo</name>
  <version>0.1.0</version>
  <description>Hexapod Gazebo simulation launch</description>
  <maintainer email="minamaher9024@gmail.com">Mina Maher</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>hexapod_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- 2D LiDAR mapping (mapping.launch.py) -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>hls_lfcd_lds_driver</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
